rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isApprovedGoogleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['REPLACE_WITH_APPROVED_EMAIL'];
    }

    match /artifacts/{workspace}/public/data/stock_state/{document} {
      allow read, write: if isApprovedGoogleUser();
    }
  }
}
